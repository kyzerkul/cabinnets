# PostgreSQL — standard connection string, any Postgres host works
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public site URL — OPTIONAL, and ignored on Vercel.
#
# The canonical origin now lives in code, in lib/site-config.ts
# (PRODUCTION_ORIGIN). On any Vercel build that constant wins; a value set here
# that disagrees with it is reported in the build log and NOT applied.
#
# Why: this used to be the single source of truth, it was left on the apex
# (https://cabinetscomptables.online, which 308s to www) for a month, and every
# canonical and sitemap <loc> on ~3 100 pages pointed at a redirect. Google
# could not resolve the signal and indexed almost nothing. A versioned constant
# cannot drift that way unnoticed.
#
# This variable is still honoured OFF a deployment, so `next build && next start`
# and `npm run seo:check http://localhost:3000` keep working locally.
# Leave it unset for normal local work (http://localhost:3000 is the default).
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email — used for /supprimer-ma-fiche RGPD form (validated in spec 18)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
