# PostgreSQL — standard connection string, any Postgres host works
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public site URL — the single source of truth for every canonical, og:url,
# JSON-LD @id and sitemap <loc> on the site.
#
#   * absolute origin, https, NO trailing slash, NO path
#   * it MUST be the host Vercel serves WITHOUT redirecting. Confirmed from the
#     Vercel dashboard: the apex 308s to www, and www is the Production domain.
#     So the www form below is the correct value. With the apex here instead,
#     every canonical and every sitemap <loc> points at a redirect, and Google
#     will not index the pages. Re-check any time with: npm run seo:check
#   * set it for Production, Preview AND Development in the Vercel project.
#
# A production build now FAILS if this is missing, instead of silently
# emitting http://localhost:3000/... canonicals on all ~2 000 pages.
NEXT_PUBLIC_SITE_URL="https://www.cabinetscomptables.online"

# Email — used for /supprimer-ma-fiche RGPD form (validated in spec 18)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
